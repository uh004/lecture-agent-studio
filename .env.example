# AI providers
OPENAI_API_KEY=
TAVILY_API_KEY=
LLM_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts

# LangSmith tracing and evaluation
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_여기에_LangSmith_키
LANGSMITH_PROJECT=lecture-agent-studio

# Vercel Marketplace: Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# When Vercel creates legacy KV names with the custom prefix UPSTASH_REDIS_REST:
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
JOB_TTL_SECONDS=604800
JOB_QUEUE_KEY=lecture-agent:jobs:pending
MAX_SLIDES=100

# Vercel Storage: create a Public Blob store
BLOB_READ_WRITE_TOKEN=

# Optional Vercel API wake-up URL for a sleeping worker service
WORKER_URL=

# Docker worker
WORKER_POLL_SECONDS=2
WORKER_WORK_ROOT=/tmp/lecture-agent-worker
SLIDE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# Frontend origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional local tool overrides
FFMPEG_CMD=
FFPROBE_CMD=
SOFFICE_CMD=
PDFTOPPM_CMD=
